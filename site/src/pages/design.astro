---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import themeTokens from '../../../tools/design-tokens/contentglows_theme.json';

const { colors, typography, spacing, radius, motion } = themeTokens;
---

<Layout
  title="Design Playground — ContentGlows"
  description="ContentGlows design token playground. Visual reference for colors, typography, spacing, radius, shadows, and motion."
  noindex={true}
>
  <Navbar />
  <main class="playground">
    <div class="container">
      <header class="pg-header">
        <h1>Design Playground</h1>
        <p>Live token reference for the ContentGlows design system. The canonical JSON source is injected as CSS variables by <code>Layout.astro</code>; displayed raw values are documentation, not independent UI decisions.</p>
      </header>

      <!-- COLORS -->
      <section class="pg-section">
        <h2>Color Tokens</h2>

        <h3 class="pg-group-label">Brand</h3>
        <div class="swatch-row">
          <div class="swatch" style="background:var(--color-primary);"><span>--color-primary</span><span>{colors.primary}</span></div>
          <div class="swatch" style="background:var(--color-primary-dark);"><span>--color-primary-dark</span><span>{colors.primaryDark}</span></div>
          <div class="swatch" style="background:var(--color-secondary);"><span>--color-secondary</span><span>{colors.secondary}</span></div>
          <div class="swatch" style="background:var(--color-accent);"><span>--color-accent</span><span>{colors.accent}</span></div>
        </div>

        <h3 class="pg-group-label">Neutral</h3>
        <div class="swatch-row">
          <div class="swatch dark" style="background:var(--color-dark);"><span>--color-dark</span><span>{colors.dark}</span></div>
          <div class="swatch dark" style="background:var(--color-gray);"><span>--color-gray</span><span>{colors.gray}</span></div>
          <div class="swatch light" style="background:var(--color-light-gray);"><span>--color-light-gray</span><span>{colors.lightGray}</span></div>
          <div class="swatch light" style="background:var(--color-light-blue);"><span>--color-light-blue</span><span>{colors.lightBlue}</span></div>
          <div class="swatch light bordered" style="background:var(--color-white);"><span>--color-white</span><span>{colors.white}</span></div>
        </div>

        <h3 class="pg-group-label">Support</h3>
        <div class="swatch-row">
          <div class="swatch dark" style="background:var(--color-badge-bg); color:var(--color-badge-text);"><span>--color-badge-bg</span><span>{colors.badgeBg}</span></div>
          <div class="swatch dark" style="background:var(--color-code-text); color:var(--color-text-primary);"><span>--color-code-text</span><span>{colors.codeText}</span></div>
        </div>

        <h3 class="pg-group-label">Gradient preview</h3>
        <div class="gradient-strip"></div>
      </section>

      <!-- TYPOGRAPHY -->
      <section class="pg-section">
        <h2>Typography Scale</h2>
        <p class="pg-meta">Font: <strong>Inter</strong> · Ratio: <strong>1.25</strong> · Base: <strong>1rem / 16px</strong></p>

        <div class="type-scale">
          <div class="type-row">
            <span class="type-label">--text-h1 <em>fluid</em></span>
            <span class="type-sample" style="font-size:var(--text-h1); font-weight:900; line-height:var(--leading-tight);">Heading 1</span>
          </div>
          <div class="type-row">
            <span class="type-label">--text-h2 <em>fluid</em></span>
            <span class="type-sample" style="font-size:var(--text-h2); font-weight:700; line-height:var(--leading-tight);">Heading 2</span>
          </div>
          <div class="type-row">
            <span class="type-label">--text-h3 · {typography.textH3}</span>
            <span class="type-sample" style="font-size:var(--text-h3); font-weight:700">Heading 3</span>
          </div>
          <div class="type-row">
            <span class="type-label">--text-lg · {typography.textLg}</span>
            <span class="type-sample" style="font-size:var(--text-lg);">Lead / section subtitle</span>
          </div>
          <div class="type-row">
            <span class="type-label">--text-base · {typography.textBase}</span>
            <span class="type-sample" style="font-size:var(--text-base);">Body text — readable and comfortable at this size.</span>
          </div>
          <div class="type-row">
            <span class="type-label">--text-sm · {typography.textSm}</span>
            <span class="type-sample" style="font-size:var(--text-sm);">Meta, small body, captions</span>
          </div>
          <div class="type-row">
            <span class="type-label">--text-xs · {typography.textXs}</span>
            <span class="type-sample" style="font-size:var(--text-xs); text-transform:uppercase; letter-spacing:var(--tracking-wider); font-weight:700">LABEL / BADGE</span>
          </div>
        </div>
      </section>

      <!-- SPACING -->
      <section class="pg-section">
        <h2>Spacing Scale</h2>
        <p class="pg-meta">Base: <strong>4px</strong> · Unit: <strong>0.25rem = 1</strong></p>
        <div class="space-grid">
          {[
            ['--space-1', spacing[1]],
            ['--space-2', spacing[2]],
            ['--space-3', spacing[3]],
            ['--space-4', spacing[4]],
            ['--space-5', spacing[5]],
            ['--space-6', spacing[6]],
            ['--space-8', spacing[8]],
            ['--space-10', spacing[10]],
            ['--space-12', spacing[12]],
            ['--space-16', spacing[16]],
            ['--space-20', spacing[20]],
            ['--space-24', spacing[24]],
          ].map(([token, value]) => (
            <div class="space-row">
              <div class="space-bar" style={`--space-size:var(${token})`}></div>
              <code>{token}</code>
              <span>{value}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- RADIUS -->
      <section class="pg-section">
        <h2>Border Radius</h2>
        <div class="radius-row">
          <div class="radius-chip" style="border-radius:var(--radius-sm);"><span>sm</span><em>{radius.sm}</em></div>
          <div class="radius-chip" style="border-radius:var(--radius-md);"><span>md</span><em>{radius.md}</em></div>
          <div class="radius-chip" style="border-radius:var(--radius-lg);"><span>lg</span><em>{radius.lg}</em></div>
          <div class="radius-chip" style="border-radius:var(--radius-xl);"><span>xl</span><em>{radius.xl}</em></div>
          <div class="radius-chip" style="border-radius:var(--radius-2xl);"><span>2xl</span><em>{radius['2xl']}</em></div>
          <div class="radius-chip" style="border-radius:var(--radius-pill);"><span>pill</span><em>{radius.pill}</em></div>
        </div>
      </section>

      <!-- SHADOWS -->
      <section class="pg-section">
        <h2>Shadows / Elevation</h2>
        <div class="shadow-row">
          <div class="shadow-chip" style="box-shadow:var(--shadow-sm);"><span>shadow-sm</span></div>
          <div class="shadow-chip" style="box-shadow:var(--shadow-card);"><span>shadow-card</span></div>
          <div class="shadow-chip" style="box-shadow:var(--shadow-card-hover);"><span>shadow-card-hover</span></div>
          <div class="shadow-chip" style="box-shadow:var(--shadow-card-lg);"><span>shadow-card-lg</span></div>
          <div class="shadow-chip primary-shadow" style="box-shadow:var(--shadow-primary);"><span>shadow-primary</span></div>
          <div class="shadow-chip primary-shadow" style="box-shadow:var(--shadow-primary-hover);"><span>shadow-primary-hover</span></div>
        </div>
      </section>

      <!-- MOTION -->
      <section class="pg-section">
        <h2>Motion</h2>
        <div class="motion-grid">
          <div class="motion-card">
            <div class="motion-demo" data-duration="instant">Hover me</div>
            <code>--duration-instant · {motion.instant}</code>
          </div>
          <div class="motion-card">
            <div class="motion-demo" data-duration="fast">Hover me</div>
            <code>--duration-fast · {motion.fast}</code>
          </div>
          <div class="motion-card">
            <div class="motion-demo" data-duration="base">Hover me</div>
            <code>--duration-base · {motion.base}</code>
          </div>
          <div class="motion-card">
            <div class="motion-demo" data-duration="slow">Hover me</div>
            <code>--duration-slow · {motion.slow}</code>
          </div>
          <div class="motion-card">
            <div class="motion-demo" data-duration="reveal">Hover me</div>
            <code>--duration-reveal · entrance</code>
          </div>
        </div>

        <h3 class="pg-group-label">Easing</h3>
        <div class="ease-row">
          <div class="ease-demo ease-standard">ease-standard</div>
          <div class="ease-demo ease-out">ease-out</div>
          <div class="ease-demo ease-emphasized-out">ease-emphasized-out</div>
          <div class="ease-demo ease-spring">ease-spring</div>
        </div>
      </section>

      <!-- BUTTONS -->
      <section class="pg-section">
        <h2>Button System</h2>
        <div class="btn-row">
          <a href="#" class="btn-primary">Primary button</a>
          <a href="#" class="btn-secondary">Secondary button</a>
        </div>
      </section>
    </div>
  </main>
</Layout>

<style>
  .playground {
    padding: calc(var(--space-16) + var(--space-16)) 0 var(--space-24);
    background: var(--color-surface-subtle);
    min-height: var(--height-screen);
  }

  .pg-header {
    margin-bottom: var(--space-16);
    padding-bottom: var(--space-8);
    border-bottom: calc(var(--space-1) / 2) solid var(--color-surface-tint);
  }

  .pg-header h1 {
    font-size: var(--text-h1);
    font-weight: 900;
    margin-bottom: var(--space-3);
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .pg-header p {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .pg-section {
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    padding: var(--space-10);
    margin-bottom: var(--space-8);
    box-shadow: var(--shadow-sm);
  }

  .pg-section > h2 {
    font-size: var(--text-h3);
    margin-bottom: var(--space-6);
    color: var(--color-text-primary);
    padding-bottom: var(--space-3);
    border-bottom: calc(var(--space-1) / 4) solid var(--color-surface-subtle);
  }

  .pg-meta {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .pg-group-label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-text-muted);
        padding: var(--space-6) 0 var(--space-3);
  }

  /* Swatches */
  .swatch-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .swatch {
    width: calc(var(--space-20) * 2);
    height: var(--space-20);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
        padding: var(--space-2) var(--space-3);
    color: var(--color-text-on-dark);
    font-size: var(--text-xs);
    gap: calc(var(--space-1) / 2);
  }

  .swatch.light { color: var(--color-text-primary); }
  .swatch.bordered { border: calc(var(--space-1) / 4) solid var(--color-light-gray); }

  .gradient-strip {
    height: var(--space-12);
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary), var(--color-accent));
    margin-top: var(--space-3);
  }

  /* Typography */
  .type-scale { display: flex; flex-direction: column; gap: var(--space-4); }

  .type-row {
    display: grid;
    grid-template-columns: calc(var(--space-20) + var(--space-24) + var(--space-1)) 1fr;
    align-items: center;
    gap: var(--space-4);
        padding: var(--space-3) 0;
    border-bottom: calc(var(--space-1) / 4) solid var(--color-surface-subtle);
  }

  .type-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-family: monospace;
  }

  .type-label em {
    display: block;
    font-style: normal;
    color: var(--color-primary);
  }

  /* Spacing */
  .space-grid { display: flex; flex-direction: column; gap: var(--space-3); }

  .space-row {
    display: grid;
    grid-template-columns: calc((var(--space-24) * 2) + var(--space-2)) calc(var(--space-24) + var(--space-6)) 1fr;
    align-items: center;
    gap: var(--space-4);
  }

  .space-bar {
    width: min(var(--space-size), 100%);
    height: var(--space-4);
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
    border-radius: var(--radius-pill);
    min-width: var(--space-1);
  }

  .space-row code {
    font-size: var(--text-xs);
    color: var(--color-primary);
    background: var(--color-surface-tint);
    padding: calc(var(--space-1) / 2) calc(var(--space-3) / 2);
    border-radius: var(--radius-sm);
  }

  .space-row span {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Radius */
  .radius-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .radius-chip {
    width: var(--space-20);
    height: var(--space-20);
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    color: var(--color-text-on-dark);
  }

  .radius-chip span { font-size: var(--text-xs); font-weight: 700; }
  .radius-chip em { font-size: var(--text-xs); opacity: 0.8; font-style: normal; }

  /* Shadows */
  .shadow-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .shadow-chip {
    width: calc((var(--space-16) * 2) + var(--space-3));
    height: var(--space-20);
    background: var(--color-surface);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
    padding: var(--space-2);
  }

  .shadow-chip.primary-shadow { color: var(--color-primary); }

  /* Motion */
  .motion-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(calc(var(--space-20) * 2), 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .motion-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: center;
  }

  .motion-demo {
    align-self: stretch;
    padding: var(--space-4);
    background: var(--color-surface-subtle);
    border-radius: var(--radius-md);
    text-align: center;
    font-size: var(--text-sm);
    cursor: default;
    transition: background var(--duration-base), transform var(--duration-base);
  }

  .motion-demo[data-duration="instant"] { transition-duration: var(--duration-instant); }
  .motion-demo[data-duration="fast"]    { transition-duration: var(--duration-fast); }
  .motion-demo[data-duration="base"]    { transition-duration: var(--duration-base); }
  .motion-demo[data-duration="slow"]    { transition-duration: var(--duration-slow); }
  .motion-demo[data-duration="reveal"]  { transition-duration: var(--duration-reveal); }

  .motion-demo:hover {
    background: var(--color-primary);
    color: var(--color-text-on-dark);
    transform: translateY(calc(-1 * var(--space-1)));
  }

  .motion-card code {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
  }

  /* Ease demos */
  .ease-row {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .ease-demo {
    flex: 1;
    min-width: calc(var(--space-24) + var(--space-6));
    height: calc(var(--space-12) + var(--space-2));
    background: var(--color-surface-subtle);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-xs);
    font-weight: 600;
    transition:
      background calc(var(--duration-slow) + var(--duration-base)),
      transform calc(var(--duration-slow) + var(--duration-base));
    cursor: default;
  }

  .ease-demo.ease-standard { transition-timing-function: var(--ease-standard); }
  .ease-demo.ease-out      { transition-timing-function: var(--ease-out); }
  .ease-demo.ease-emphasized-out { transition-timing-function: var(--ease-emphasized-out); }
  .ease-demo.ease-spring   { transition-timing-function: var(--ease-spring); }

  .ease-demo:hover {
    background: var(--color-secondary);
    color: var(--color-text-on-dark);
    transform: scale(1.04);
  }

  /* Buttons */
  .btn-row {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
</style>
